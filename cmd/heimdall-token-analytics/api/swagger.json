{
    "schemes": [
        "https"
    ],
    "swagger": "2.0",
    "info": {
        "description": "This service provides analytics data for various tokens.",
        "title": "Token Analytics Service API.",
        "contact": {
            "name": "ice.io",
            "url": "https://ice.io"
        },
        "version": "latest"
    },
    "paths": {
        "/v1/community-tokens": {
            "get": {
                "description": "Returns community tokens information for the given Ion Connect addresses.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Tokens"
                ],
                "parameters": [
                    {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "collectionFormat": "multi",
                        "example": "0x1234...,0x5678...",
                        "description": "Ion Connect address of the user",
                        "name": "ionConnectAddress",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Auth token",
                        "name": "Authorization",
                        "in": "header",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/model.TokenAnalytics"
                            }
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/server.ResponseErrorBody"
                        }
                    },
                    "504": {
                        "description": "if request times out",
                        "schema": {
                            "$ref": "#/definitions/server.ResponseErrorBody"
                        }
                    }
                }
            }
        },
        "/v1/community-tokens/address/{ionConnectAddress}/latest-trades": {
            "get": {
                "description": "Returns trade history for a specific community token address.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Tokens"
                ],
                "parameters": [
                    {
                        "type": "string",
                        "example": "\"0x1234...\"",
                        "description": "Ion Connect address",
                        "name": "ionConnectAddress",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "integer",
                        "format": "int32",
                        "example": 10,
                        "description": "Number of items to return",
                        "name": "limit",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "format": "int32",
                        "example": 0,
                        "description": "Number of items to skip",
                        "name": "offset",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Auth token",
                        "name": "Authorization",
                        "in": "header",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/model.Trade"
                            }
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/server.ResponseErrorBody"
                        }
                    },
                    "504": {
                        "description": "if request times out",
                        "schema": {
                            "$ref": "#/definitions/server.ResponseErrorBody"
                        }
                    }
                }
            }
        },
        "/v1/community-tokens/{type}": {
            "get": {
                "description": "Returns community tokens information for the given Ion Connect addresses.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Tokens"
                ],
                "parameters": [
                    {
                        "type": "string",
                        "example": "\"latest\"",
                        "description": "Type of data",
                        "name": "type",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "example": "\"bitcoin\"",
                        "description": "Search keyword",
                        "name": "keyword",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "format": "int32",
                        "example": 10,
                        "description": "Number of items to return",
                        "name": "limit",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "format": "int32",
                        "example": 0,
                        "description": "Number of items to skip",
                        "name": "offset",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Auth token",
                        "name": "Authorization",
                        "in": "header",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/model.TokenAnalytics"
                            }
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/server.ResponseErrorBody"
                        }
                    },
                    "504": {
                        "description": "if request times out",
                        "schema": {
                            "$ref": "#/definitions/server.ResponseErrorBody"
                        }
                    }
                }
            }
        },
        "/v1/community-tokens/{type}/viewing-sessions": {
            "post": {
                "description": "Creates a new session view for community tokens analytics.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Tokens"
                ],
                "parameters": [
                    {
                        "type": "string",
                        "example": "\"latest\"",
                        "description": "Type of session view",
                        "name": "type",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Auth token",
                        "name": "Authorization",
                        "in": "header",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/main.SessionViewCreateResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/server.ResponseErrorBody"
                        }
                    },
                    "504": {
                        "description": "if request times out",
                        "schema": {
                            "$ref": "#/definitions/server.ResponseErrorBody"
                        }
                    }
                }
            }
        },
        "/v1/community-tokens/{type}/viewing-sessions/{viewingSessionId}": {
            "get": {
                "description": "Returns community tokens information for a specific viewing session.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Tokens"
                ],
                "parameters": [
                    {
                        "type": "string",
                        "example": "\"top\"",
                        "description": "Type of data",
                        "name": "type",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "example": "\"session_12345\"",
                        "description": "Viewing session ID",
                        "name": "viewingSessionId",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "example": "\"bitcoin\"",
                        "description": "Search keyword",
                        "name": "keyword",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "format": "int32",
                        "example": 10,
                        "description": "Number of items to return",
                        "name": "limit",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "format": "int32",
                        "example": 0,
                        "description": "Number of items to skip",
                        "name": "offset",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Auth token",
                        "name": "Authorization",
                        "in": "header",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/model.TokenAnalytics"
                            }
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/server.ResponseErrorBody"
                        }
                    },
                    "504": {
                        "description": "if request times out",
                        "schema": {
                            "$ref": "#/definitions/server.ResponseErrorBody"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "main.SessionViewCreateResponse": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string",
                    "example": "session_12345"
                },
                "ttl": {
                    "type": "integer",
                    "example": 3600000
                }
            }
        },
        "model.Addresses": {
            "type": "object",
            "properties": {
                "blockchain": {
                    "type": "string"
                },
                "ionConnect": {
                    "type": "string"
                }
            }
        },
        "model.MarketData": {
            "type": "object",
            "properties": {
                "holders": {
                    "type": "integer"
                },
                "marketCap": {
                    "type": "integer"
                },
                "position": {
                    "$ref": "#/definitions/model.Position"
                },
                "priceUSD": {
                    "type": "number"
                },
                "ticker": {
                    "type": "string"
                },
                "volume": {
                    "type": "integer"
                }
            }
        },
        "model.Position": {
            "type": "object",
            "properties": {
                "amount": {
                    "type": "integer"
                },
                "amountUSD": {
                    "type": "number"
                },
                "pnl": {
                    "type": "number"
                },
                "pnlPercentage": {
                    "type": "number"
                },
                "rank": {
                    "type": "integer"
                }
            }
        },
        "model.TokenAnalytics": {
            "type": "object",
            "properties": {
                "addresses": {
                    "$ref": "#/definitions/model.Addresses"
                },
                "createdAt": {
                    "type": "string"
                },
                "creator": {
                    "$ref": "#/definitions/model.User"
                },
                "description": {
                    "type": "string"
                },
                "imageUrl": {
                    "type": "string"
                },
                "marketData": {
                    "$ref": "#/definitions/model.MarketData"
                },
                "title": {
                    "type": "string"
                },
                "type": {
                    "type": "string"
                }
            }
        },
        "model.Trade": {
            "type": "object",
            "properties": {
                "creator": {
                    "$ref": "#/definitions/model.User"
                },
                "position": {
                    "$ref": "#/definitions/model.TradePosition"
                }
            }
        },
        "model.TradePosition": {
            "type": "object",
            "properties": {
                "addresses": {
                    "$ref": "#/definitions/model.Addresses"
                },
                "amount": {
                    "type": "integer"
                },
                "amountUSD": {
                    "type": "number"
                },
                "balance": {
                    "type": "integer"
                },
                "balanceUSD": {
                    "type": "number"
                },
                "createdAt": {
                    "type": "string"
                },
                "holder": {
                    "$ref": "#/definitions/model.User"
                },
                "type": {
                    "type": "string"
                }
            }
        },
        "model.User": {
            "type": "object",
            "properties": {
                "avatar": {
                    "type": "string"
                },
                "display": {
                    "type": "string"
                },
                "ionConnect": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "verified": {
                    "type": "boolean"
                }
            }
        },
        "server.ResponseErrorBody": {
            "type": "object",
            "properties": {
                "code": {
                    "type": "string",
                    "example": "SOMETHING_NOT_FOUND"
                },
                "error": {
                    "type": "string",
                    "example": "something is missing"
                }
            }
        }
    }
}